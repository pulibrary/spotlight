# frozen_string_literal: true

source 'https://rubygems.org'

# the below was initially generated by engine_cart, but has been updated as part
# of removing that gem
file = File.expand_path('Gemfile', File.expand_path('.internal_test_app', File.dirname(__FILE__)))
if File.exist?(file)
  begin
    eval_gemfile file
  rescue Bundler::GemfileError => e
    Bundler.ui.warn 'Internal test app not found. Skipping Rails application dependencies:'
    Bundler.ui.warn e.message
    gemspec
  end
else
  Bundler.ui.warn "Unable to find test application dependencies in #{file}, using placeholder dependencies"
  gemspec
end

eval_gemfile File.expand_path('spec/test_app_templates/Gemfile.extra', File.dirname(__FILE__)) unless File.exist?(file)
